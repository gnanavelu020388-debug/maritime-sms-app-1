# ═══════════════════════════════════════════════════════════════
# Maritime Safety Management Platform — Environment Variables
# Copy this file to .env and fill in your Google Cloud credentials.
# ═══════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production

# ── JWT ───────────────────────────────────────────────────────
# Generate a strong random secret for production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-strong-random-secret

# ── Google Cloud SQL (MySQL) ──────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=maritime_app
DB_PASSWORD=your-cloud-sql-password
DB_NAME=maritime_platform

# For Cloud Run with Cloud SQL, use the Unix socket path instead:
# DB_HOST=/cloudsql/your-project:region:your-instance

# ── Google Cloud Storage ──────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=maritime-platform-docs
# Path to service account JSON key file (for local dev / Cloud Run secret mount)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ── Frontend (Vite) ───────────────────────────────────────────
# Only needed if frontend talks to a different origin than /api
# VITE_API_BASE=https://api.your-domain.com/api
