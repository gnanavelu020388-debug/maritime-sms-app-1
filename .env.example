# ═══════════════════════════════════════════════════════════════
# Maritime Safety Management Platform — Environment Variables
# Google Cloud Run + Cloud SQL + Cloud Storage
# ═══════════════════════════════════════════════════════════════

# ── Server (Google Cloud Run) ────────────────────────────────
PORT=8080
NODE_ENV=production

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-strong-random-secret

# ── Database ──────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=maritime_app
DB_PASSWORD=your-cloud-sql-password
DB_NAME=maritime_platform

# For Cloud Run with Cloud SQL, use the Unix socket path instead:
# DB_HOST=/cloudsql/your-project:region:your-instance
# CLOUD_SQL_CONNECTION_NAME=your-project:region:your-instance

# ── Google Cloud Storage ──────────────────────────────────────
GCS_BUCKET_NAME=maritime-sms-platform-docs

# Local dev only: path to a service account key with roles/storage.objectUser
# on the bucket above. Leave unset on Cloud Run — the service picks up
# credentials automatically from its attached runtime service account
# (see GCS_RUNTIME_SERVICE_ACCOUNT in cloudbuild.yaml / the deploy workflow),
# which also needs roles/iam.serviceAccountTokenCreator on itself to mint
# signed URLs.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
